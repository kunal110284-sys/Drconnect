# Which MyDox runtime this file represents (used by npm run env:use:*)
MYDOX_ENV=local

# Hosted UAT URL (used when building the UAT APK; not loaded by local Vite)
MYDOX_APP_URL=https://drconnect-uat.vercel.app

# Browser-safe Supabase values (local/dev — usually same staging project)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Server-only Supabase values
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY

# Optional push transport
PUSH_DISPATCH_SECRET=
FCM_SERVICE_ACCOUNT_JSON=

# Optional server-only home-visit expiry/outbox scheduler authentication (32+ chars).
HOME_VISIT_JOB_SECRET=

# Optional AI gateway used by existing AI features
LOVABLE_API_KEY=

# Local diagnostics — ok for local only
VITE_ENABLE_DEV_TOOLS=true

MYDOX_ENABLE_DEMO_LOGIN=true
MYDOX_DEMO_PASSWORD=demo123456
MYDOX_DEMO_SPECIAL_PASSWORD=CareDemo!2026
